PORT=3000
# Cadena de conexión de PostgreSQL (Neon). Ej: postgres://usuario:clave@host/neondb?sslmode=require
DATABASE_URL=
# Secreto largo y aleatorio: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_un_secreto_largo
JWT_EXPIRES_IN=2h
# Clave AES-256 (64 caracteres hex) para cifrar teléfono/email de contactos
DATA_KEY=
# Opcional: si está vacío se usa el OSRM peatonal de FOSSGIS
ORS_API_KEY=
DEFAULT_CITY=girardot
NODE_ENV=development
# URL pública de la app (para CORS). Vacío = solo mismo origen
APP_URL=
# Contraseñas de las cuentas de prueba creadas por npm run db:init
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
# Opcional (P1): alertas a contactos por Telegram
TELEGRAM_BOT_TOKEN=
