<%- include('../layout/head') %>
<%- include('../layout/header', { bodyClass: 'page-auth' }) %>
<div class="auth">
  <section class="auth-hero" aria-labelledby="hero-title">
    <%- include('../layout/street') %>
    <p class="eyebrow">Tu cuenta, tus datos</p>
    <h1 id="hero-title">Camina acompañada, aunque vayas sola.</h1>
    <p class="lead">Guardamos solo lo necesario: tu nombre, tu correo y las rutas que tú decidas iniciar.</p>
  </section>

  <section class="card auth-card" aria-labelledby="form-title">
    <h2 id="form-title">Crea tu cuenta</h2>
    <form method="post" action="/register" class="stack">
      <div class="field<%= errors.name ? ' has-error' : '' %>">
        <label for="name">¿Cómo te llamamos?</label>
        <input id="name" name="name" type="text" autocomplete="given-name" required minlength="2" maxlength="100"
          value="<%= values.name || '' %>" <% if (errors.name) { %>aria-invalid="true" aria-describedby="name-error"<% } %>>
        <% if (errors.name) { %><p class="field-error" id="name-error"><%= errors.name %></p><% } %>
      </div>
      <div class="field<%= errors.email ? ' has-error' : '' %>">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="150"
          value="<%= values.email || '' %>" <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
        <% if (errors.email) { %><p class="field-error" id="email-error"><%= errors.email %></p><% } %>
      </div>
      <div class="field<%= errors.password ? ' has-error' : '' %>">
        <label for="password">Contraseña</label>
        <div class="input-with-btn">
          <input id="password" name="password" type="password" autocomplete="new-password" required minlength="10" maxlength="72"
            aria-describedby="password-hint<%= errors.password ? ' password-error' : '' %>" <% if (errors.password) { %>aria-invalid="true"<% } %>>
          <button type="button" class="icon-btn reveal" data-reveal="password" aria-label="Mostrar contraseña" aria-pressed="false">
            <svg class="icon" aria-hidden="true"><use href="#i-eye"/></svg>
          </button>
        </div>
        <p class="field-hint" id="password-hint">Mínimo 10 caracteres, con letras y números.</p>
        <% if (errors.password) { %><p class="field-error" id="password-error"><%= errors.password %></p><% } %>
      </div>
      <div class="field field-check<%= errors.acceptPolicy ? ' has-error' : '' %>">
        <input id="acceptPolicy" name="acceptPolicy" type="checkbox" required
          <% if (errors.acceptPolicy) { %>aria-invalid="true" aria-describedby="policy-error"<% } %>>
        <label for="acceptPolicy">Acepto el tratamiento de mis datos según la <a href="/privacidad" target="_blank" rel="noopener">política de privacidad</a> (Ley 1581 de 2012).</label>
        <% if (errors.acceptPolicy) { %><p class="field-error" id="policy-error"><%= errors.acceptPolicy %></p><% } %>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Crear mi cuenta</button>
    </form>
    <p class="muted center">¿Ya tienes cuenta? <a href="/login">Inicia sesión</a></p>
  </section>
</div>
<p class="disclaimer">Esta herramienta es un apoyo, no una garantía de seguridad. En emergencia llama al <a href="tel:123">123</a>.</p>
<%- include('../layout/footer', { scripts: ['/js/forms.js'] }) %>
