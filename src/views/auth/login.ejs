<%- include('../layout/head') %>
<%- include('../layout/header', { bodyClass: 'page-auth' }) %>
<div class="auth">
  <section class="auth-hero" aria-labelledby="hero-title">
    <%- include('../layout/street') %>
    <p class="eyebrow">Girardot, de noche</p>
    <h1 id="hero-title">Vuelve a casa por la calle con más luz.</h1>
    <p class="lead">Compara la ruta rápida con la más acompañada, avisa a tu gente y pide ayuda con un toque.</p>
  </section>

  <section class="card auth-card" aria-labelledby="form-title">
    <h2 id="form-title">Inicia sesión</h2>
    <div aria-live="assertive">
      <% if (errors.form) { %><p class="notice notice-error"><%= errors.form %></p><% } %>
    </div>
    <form method="post" action="/login" class="stack">
      <div class="field<%= errors.email ? ' has-error' : '' %>">
        <label for="email">Correo electrónico</label>
        <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength="150"
          value="<%= values.email || '' %>" <% if (errors.email) { %>aria-invalid="true" aria-describedby="email-error"<% } %>>
        <% if (errors.email) { %><p class="field-error" id="email-error"><%= errors.email %></p><% } %>
      </div>
      <div class="field<%= errors.password ? ' has-error' : '' %>">
        <label for="password">Contraseña</label>
        <div class="input-with-btn">
          <input id="password" name="password" type="password" autocomplete="current-password" required maxlength="72"
            <% if (errors.password) { %>aria-invalid="true" aria-describedby="password-error"<% } %>>
          <button type="button" class="icon-btn reveal" data-reveal="password" aria-label="Mostrar contraseña" aria-pressed="false">
            <svg class="icon" aria-hidden="true"><use href="#i-eye"/></svg>
          </button>
        </div>
        <% if (errors.password) { %><p class="field-error" id="password-error"><%= errors.password %></p><% } %>
      </div>
      <button class="btn btn-primary btn-block" type="submit">Entrar</button>
    </form>
    <p class="muted center">¿Primera vez? <a href="/register">Crea tu cuenta en un minuto</a></p>
  </section>
</div>
<p class="disclaimer">Esta herramienta es un apoyo, no una garantía de seguridad. En emergencia llama al <a href="tel:123">123</a>.</p>
<%- include('../layout/footer', { scripts: ['/js/forms.js'] }) %>
